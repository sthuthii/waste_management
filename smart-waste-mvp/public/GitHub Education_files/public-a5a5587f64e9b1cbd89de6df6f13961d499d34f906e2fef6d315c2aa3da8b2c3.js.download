$(document).ready(() =>
  $(".js-org-trigger").on("click", (event) => $(".js-org-target").toggle()),
);
$(document).ready(() => {
  scrollToErrorFlashMessage();
  process_application();
  handleFormSubmit();

  function process_application() {
    $(".final-submit").on("click", function() {
      clearFlashMessages();
      deviceCameraExists();
    });
  }

  function handleFormSubmit() {
    // On form submit success
    $("#edit_discount_request").on("ajax:success", function() {
      const discountRequestId = $(".discount_request_id").data("discount-request-id");
      initiatePolling(discountRequestId);
    });

    // On form submit error
    $("#edit_discount_request").on("ajax:error", function(event, data, status, xhr){
      if (data["responseJSON"]) {
        window.location.href = data["responseJSON"]["redirect_url"];
      } else {
        window.location.href = "/discount_requests/application";
      }
    });
  }

  deviceCameraExists = async function() {
    const hiddenInputElement = $("#discount_request_device_with_camera");
    if (!hiddenInputElement || hiddenInputElement.val() === "true") return;
    if (!!navigator.mediaDevices?.enumerateDevices) { // browser supports checking for cameras
      hiddenInputElement.val(true);
      return;
    }

    await navigator.mediaDevices
      .enumerateDevices()
      .then((devices) => hiddenInputElement.val(devices.some((device) => "videoinput" === device.kind)));
  }

  function scrollToErrorFlashMessage() {
    let flashMessage = document.getElementById("flash-message");
    if (flashMessage) {
      flashMessage.scrollIntoView({ behavior: "smooth" });
    }
  }

  function clearFlashMessages() {
    $("#flash-message").empty();
  }

  function initiatePolling(discountRequestId) {
    // Time in milliseconds
    const pollInterval = 5000;
    const timerInterval = 1000;
    const totalTime = 30000;

    $(".final-submit").prop("hidden", true);
    $(".js-cancel-application").prop("hidden", true);
    $(".info-text").prop("hidden", true);
    $(".honor-roll").prop("hidden", false);

    let progressBar = $(".grading-progress");
    progressBar.append("<span class='progress'></span>");
    progressBar.append("<span class='percent-text'></span>");
    $('.percent-text').text('0 %');

    // announce the start of the progress
    LiveRegion.announce("Your application is being processed. Please wait.", "assertive");

    setTimeout(displayProgressBar(0, totalTime, timerInterval), 0);
    setTimeout(pollHonorRoll(discountRequestId, 0, totalTime, pollInterval), 0);
  }

  function displayProgressBar(elapsedTime, totalTime, timerInterval) {
    let percentText = $('.percent-text').html();
    if (percentText === '100 %') {
    // announce the completion of the progress
      LiveRegion.announce("Your application has been processed.", "assertive");
      return;
    }

    let progress = parseInt(elapsedTime / totalTime * 100, 10);

    // make announcements of progress every 20%
    const progressIntervals = [20, 40, 60, 80];
    if (progressIntervals.includes(progress)) {
      LiveRegion.announce(`${progress}%`, "assertive");
    }

    $('.progress').css('width', progress + '%');
    $('.percent-text').text(progress + ' %');

    let timeLeft = (totalTime - elapsedTime) / 1000 >> 0;
    if (timeLeft > 0) {
      setTimeout(() => displayProgressBar(elapsedTime + timerInterval, totalTime, timerInterval), timerInterval);
    }
    return true;
  }

  function displayCompletedProgressBar() {
    let progress = 100;
    $('.progress').css('width', progress + '%');
    $('.percent-text').text(progress + ' %');
  }

  function pollHonorRoll(discountRequestId, elapsedTime, totalTime, pollInterval) {
    $.ajax({
      url: `/discount_requests/${discountRequestId}/poll_honor_roll`,
      type: "GET",
      success: function (data) {
        let status = data["status"];
        elapsedTime += pollInterval;
        if (elapsedTime >= totalTime || status === "processed") {
          // Redirect
          $.ajax({
            url: "handle_redirect",
            type: "GET",
            async: false,
            data: {
              state: data["state"]
            },
            success: function (data) {
              displayCompletedProgressBar();
              window.location.href = data["redirect_url"];
            },
            error: function () {
              alert("Something went wrong while processing your application");
              window.location.reload();
            }
          });
          return true;
        }
        setTimeout(() => pollHonorRoll(discountRequestId, elapsedTime, totalTime, pollInterval), pollInterval);
      },
      error: function () {
        alert("Something went wrong while processing your application");
        window.location.reload();
      },
    });
    return true;
  }
});
removeJSImageValidations = function() {
  let featureFlag;
  featureFlag = $('#submit-application').data('image-validations');
  return !!featureFlag;
};
if (!removeJSImageValidations()) {
  $(document).ready(() => handleFileUpload());
}

const handleFileUpload = () => {
  $(".file-upload").bind("change", function () {
    // Generate error message if file upload is larger than 1MB (nginx limit)
    if (this.files[0] != null && this.files[0].size / 1024 / 1024 > 1) {
      alert("File size is too large. Limit is 1MB.");
      $(this).closest(".file-upload").val("");
    }
  });
}
;
$(function () {
  // After the DOMContentLoaded event has fired, touch each flash message to
  // trigger screen readers to announce the message.
  const allFlashAlerts = document.querySelectorAll('.js-flash-message')
  const criticalFlashContainer = document.querySelector('.js-critical-flash-container')

  if (criticalFlashContainer) {
    criticalFlashContainer.focus();
  }

  if (allFlashAlerts.length > 0) {
    setTimeout(() => {
      for (const flashAlertContent of allFlashAlerts) {
        insertNonBreakingSpace(flashAlertContent);
      }
    }, 500);
  }
})

// Insert an .sr-only span containing a non-breaking space into the flash
// content. This is necessary to ensure that screen readers announce this.
function insertNonBreakingSpace(flashAlertContent) {
  const nonBreakingSpace = document.createTextNode('\u00A0');
  const span = document.createElement('span');
  span.classList.add('sr-only');
  span.appendChild(nonBreakingSpace);
  flashAlertContent.appendChild(span);
}
;
(function() {
  var clearSchoolInputField, displayDisallowMessage, displayState, enableSubmit, formShown, handleAddNewEmail, handleAttachmentProofTypeChange, handleAttachmentProofTypeOtherSelection, handleCountryChange, handleSchoolInput, handleFarFromCampusReasonChange, hideInformationMessages, initSchoolAutocomplete, setState;

  $(document).ready(function() {
    formShown();
    return displayState();
  });

  formShown = function() {
    enableSubmit();
    handleSchoolInput();
    handleAddNewEmail();
    handleCountryChange();
    initSchoolAutocomplete();
    handleAttachmentProofTypeChange();
    handleFarFromCampusReasonChange();
    return handleAttachmentProofTypeOtherSelection();
  };
  
  displayState = function (countrySelect) {
    var $countrySelect = $(countrySelect);
    if ($countrySelect != undefined && $countrySelect.length) {
      var $caProv, $countryValue, $otherStateProv, $usState;
      $usState = $("select").closest(".js-us-state", $countrySelect);
      $caProv = $("select").closest(".js-ca-prov", $countrySelect);
      $otherStateProv = $("input:text").closest(
        ".js-other-state-prov",
        $countrySelect
      );
      $countryValue = $countrySelect.val();
      if ($countryValue === "US") {
        $caProv.hide();
        $otherStateProv.hide();
        return $usState.show();
      } else if ($countryValue === "CA") {
        $usState.hide();
        $otherStateProv.hide();
        return $caProv.show();
      } else {
        $usState.hide();
        $caProv.hide();
        return $otherStateProv.show();
      }
    }
  };

  displayDisallowMessage = function(allowlistedDomains, permissibleDomains, schoolName) {
    var allDomains;
    if (!allowlistedDomains) {
      return;
    }
    allowlistedDomains.sort();
    allDomains = allowlistedDomains.concat(permissibleDomains).filter((function(_this) {
      return function(n) {
        return n;
      };
    })(this)).sort();
    $('.js-verification').html('');
    $('.js-verification-expand-button').hide().removeAttr('open').attr('aria-label', 'Show all acceptable email domains');
    $('.js-verification-expand-button .Button-label').html('Show More');
    $('.js-verification-expand-button').off('click');
    if (permissibleDomains && permissibleDomains.length) {
      $('.js-verification').html(formatDomainList(allowlistedDomains));
      $('.js-verification-expand-button').show();
      $('.js-verification-expand-button').on('click', function(event) {
        var isExpanded;
        isExpanded = $('.js-verification-expand-button').attr('open');
        if (isExpanded) {
          $('.js-verification').html(formatDomainList(allowlistedDomains));
          $('.js-verification-expand-button').attr('aria-label', 'Show all acceptable email domains').removeAttr('open');
          return $('.js-verification-expand-button .Button-label').html('Show More');
        } else {
          $('.js-verification').html(formatDomainList(allDomains));
          $('.js-verification-expand-button').attr('aria-label', 'Show Less').attr('open', 'true');
          return $('.js-verification-expand-button .Button-label').html('Show Less');
        }
      });
    } else {
      $('.js-verification-expand-button').hide().removeAttr('open');
      $('.js-verification').html(formatDomainList(allowlistedDomains));
    }
    $('.js-school-name').text(schoolName);
    showVerificationMessage();
    return $('.final-submit').prop('disabled', true);
  };

  formatDomainList = function(domains) {
    // using document.createElement('span').innerText to avoid XSS
    const list = domains.map((domain) => `<li>${document.createElement('span').innerText = domain}</li>`).join("");
    return `<ul class='text-emphasized ml-3'>${list}</ul>`;
  };

  showVerificationMessage = () => {
    const verificationMessage = document.getElementById('verification-required');
    const verificationText = document.querySelector('.js-verification-text');
    const emailDomainsList = document.querySelector('.js-verification');
    const helpText = document.querySelector('.js-verification-help-message');
    const expandButton = document.querySelector('.js-verification-expand-button');
    const inputEmailButton = document.querySelector('.js-display-email-input-button');

    if (!verificationMessage) {
      return;
    }

    verificationMessage.classList.remove('hide');
    let messageText = verificationText.textContent + emailDomainsList.textContent + " ";
    if (expandButton && !expandButton.classList.contains('hide') && expandButton.style.display !== 'none') {
      messageText += expandButton.textContent + " ";
    }
    if (helpText && !helpText.classList.contains('hide')) {
      messageText += helpText.textContent;
    }
    if (inputEmailButton) {
      messageText += inputEmailButton.textContent;
    }

    LiveRegion.announce(messageText);
  };

  initSchoolAutocomplete = function() {
    var $schoolCompleter;
    $schoolCompleter = $('.js-school auto-complete');
    $schoolCompleter.on('auto-complete-change', function(event) {
      $('#school-input').removeAttr('invalid');
      var allowlistedDomains, autocompletedSchool, combinedDomains, permissibleDomains, schoolName, selectedEmail;
      $('#verification-required').addClass('hide');
      $('.informal-partner').hide();
      autocompletedSchool = $schoolCompleter.val();
      if (!autocompletedSchool) {
        return;
      }
      autocompletedSchool = JSON.parse(autocompletedSchool);
      $(event.relatedTarget).val(autocompletedSchool.name);
      $('#discount_request_school_name').val(autocompletedSchool.name);
      if (autocompletedSchool.informal_partner === true && autocompletedSchool.issues_coupons && $('#discount_request_user_type').val() === "student") {
        $('.informal-partner').show();
        $('.final-submit').prop('disabled', true);
      }
      allowlistedDomains = autocompletedSchool.allowlisted_domains || null;
      permissibleDomains = autocompletedSchool.other_domains || null;
      combinedDomains = allowlistedDomains.concat(permissibleDomains);
      selectedEmail = $('#discount_request_school_email').val() || "";
      schoolName = $('#js-default-email-school').val() || "";

      $('.js-mismatched-school-email').hide();
      if (autocompletedSchool.name !== schoolName) {
        $('.js-mismatched-school-email').show();
      }
      $('.js-single-email-message').hide();
      $('.js-single-email-message').each(function() {
        var elementSchoolName;
        elementSchoolName = $(this).data('school-name');
        if (elementSchoolName && elementSchoolName !== autocompletedSchool.name) {
          return $(this).show();
        }
      });
      if (autocompletedSchool.verification_required || autocompletedSchool.school_system_verification_required) {
        if (autocompletedSchool.name === schoolName) {
          return;
        }
        if (!autocompletedSchool.user_has_matching_email && combinedDomains.length && !combinedDomains.includes(selectedEmail.split("@")[1])) {
          $('#school-input').attr('invalid', true);
          return displayDisallowMessage(allowlistedDomains, permissibleDomains, autocompletedSchool.name);
        }
      }
    });
    return $schoolCompleter.find('input').keyup(function() {
      var autocompletedSchool;
      autocompletedSchool = $(this).val();
      $('#discount_request_school_name').val(autocompletedSchool);
      if (autocompletedSchool.length !== 0 && $('#earlyReVerifyWarning').prop('hidden')) {
        return $('.final-submit').prop('disabled', false);
      }
    });
  };

  enableSubmit = function() {
    return $('form input[type="submit"]').prop('disabled', false);
  };

  hideInformationMessages = function() {
    $('.js-academic-status-message').hide();
    $('.js-faculty').hide();
    $('.informal-partner').hide();
    $('#verification-required').addClass('hide');
    return $('#js-suggest-allowlisted').hide();
  };

  clearSchoolInputField = function() {
    $('#school-input').val("");
    return $('#school-input').prop('disabled', false);
  };

  handleSchoolInput = function() {
    $('.js-flash-close').click(function(event) {
      event.preventDefault();
      return $('.js-email-school-section').show();
    });
  };

  handleAddNewEmail = function() {
    return $('.js-add-email-address-button').on('click', function(event) {
      return event.preventDefault();
    });
  };

  handleCountryChange = function() {
    var $countrySelect;
    $countrySelect = $('.js-country-select');
    return $countrySelect.change(function() {
      return displayState(this);
    });
  };

  handleAttachmentProofTypeChange = function() {
    var $attachmentProofTypeChange;
    $attachmentProofTypeChange = $('.js-attachment-proof-type-select');
    return $attachmentProofTypeChange.change(function() {
      $('.js-processing-application').prop('hidden', true);
      $('.js-error-processing-application').prop('hidden', true);
      $('.js-form-submission-buttons').prop('hidden', true);
      $('.js-cancel-application').removeClass('disabled');
      return $('.js-preprocess-button').prop('hidden', false);
    });
  };

  handleFarFromCampusReasonChange = function() {
    var $attachmentProofTypeChange;
    $attachmentProofTypeChange = $('.js_far_from_campus_reason');
    return $attachmentProofTypeChange.change(function() {
      $('.js-form-submission-buttons').prop('hidden', true);
      return $('.js-preprocess-button').prop('hidden', false);
    });
  };

  handleAttachmentProofTypeOtherSelection = function() {
    var $attachmentProofTypeOther;
    $attachmentProofTypeOther = $('.js-attachment-proof-type-select');
    return $attachmentProofTypeOther.change(function() {
      var regexp;
      regexp = new RegExp("^[0-9]+\\. Other");
      if (regexp.test($attachmentProofTypeOther.val())) {
        $('#discount_request_attachment_proof_type_other').prop('required', true);
        return $('.js-attachment-proof-type-other-text-field').prop('hidden', false);
      } else {
        $('#discount_request_attachment_proof_type_other').prop('required', false);
        return $('.js-attachment-proof-type-other-text-field').prop('hidden', true);
      }
    });
  };

  setState = function(country, state) {
    var ca_provinces, us_states;
    if (country === 'US') {
      us_states = {
