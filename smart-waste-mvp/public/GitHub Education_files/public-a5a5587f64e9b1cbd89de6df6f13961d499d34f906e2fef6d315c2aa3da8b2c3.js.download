        "New York": "NY",
        "Ohio": "OH",
        "Oklahoma": "OK",
        "Oregon": "OR",
        "Pennsylvania": "PA",
        "Puerto Rico": "PR",
        "Palau": "PW",
        "Rhode Island": "RI",
        "South Carolina": "SC",
        "South Dakota": "SD",
        "Tennessee": "TN",
        "Texas": "TX",
        "Utah": "UT",
        "Virginia": "VA",
        "Virgin Islands": "VI",
        "Vermont": "VT",
        "Washington": "WA",
        "Wisconsin": "WI",
        "West Virginia": "WV",
        "Wyoming": "WY",
        "Military Americas": "AA",
        "Military Europe/ME/Canada": "AE",
        "Military Pacific": "AP"
      };
      if (us_states[state]) {
        return $('#discount_request_us_state').val(us_states[state]);
      } else {
        return $('#discount_request_us_state').val(state);
      }
    } else if (country === 'CA') {
      ca_provinces = {
        "Alberta": "AB",
        "Manitoba": "MB",
        "British Columbia": "BC",
        "New Brunswick": "NB",
        "Newfoundland and Labrador": "NL",
        "Nova Scotia": "NS",
        "Northwest Territories": "NT",
        "Nunavut": "NU",
        "Ontario": "ON",
        "Prince Edward Island": "PE",
        "Quebec": "QC",
        "Saskatchewan": "SK",
        "Yukon Territory": "YT"
      };
      if (ca_provinces[state]) {
        return $('#discount_request_ca_prov').val(ca_provinces[state]);
      } else {
        return $('#discount_request_ca_prov').val(state);
      }
    } else {
      $('#discount_request_state_prov').val(state);
      return $('#discount_request_state_prov').prop('readonly', true);
    }
  };

  $(document).on('click', 'input[type="radio"][name="school_results"]', function() {
    var $address, $city, $country, $school;
    $school = $('input[type="radio"][name="school_results"]:checked');
    $city = $('#discount_request_city');
    $city.val($school.data('city'));
    if ($school.data('city') === '') {
      $city.prop('readonly', false);
    } else {
      $city.prop('readonly', true);
    }
    $country = $('#discount_request_country');
    if ($school.data('country').length <= 2) {
      $country.val($school.data('country'));
    }
    displayState();
    setState($('#discount_request_country').val(), $school.data('state'));
    $address = $('#discount_request_address');
    $address.val($school.data('address'));
    $address.prop('readonly', true);
    $('#discount_request_school_name').val($school.val());
    $('#school-lat').val($school.data('latitude'));
    return $('#school-long').val($school.data('longitude'));
  });

  $(document).on('click', '#submit-school-info', function(e) {
    var $bingMaps, $school;
    $school = $('input[type="radio"][name="school_results"]:checked');
    $bingMaps = $('input[type="text"][name="bingMapsShown"]').val();
    if (!$school.length && $bingMaps === 'true') {
      e.preventDefault();
      return alert("Please select a school from the map");
    }
  });

  $(document).on('click', 'input[type="radio"][name="user_type"]', function() {
    var $userType, allowlistedForFaculty, allowlistedForStudents, schoolName;
    hideInformationMessages();
    clearSchoolInputField();
    $userType = $('input[type="radio"][name="user_type"]:checked');
    if ($userType.val() === 'student') {
      $('#application').prop('hidden', false);
      $('#partner_school_application_form').prop('hidden', true);
      $('.previous-requests').prop('hidden', false);
      $('#faculty-benefits-header').prop('hidden', true);
      $('#student-benefits-header').prop('hidden', false);
      $('#school-application-root').prop('hidden', true);
      $('#student-info').prop('hidden', false);
      $('#teacher-info').prop('hidden', true);
      $('#discount_request_user_type').val('student');
      $('#js-school-auto-complete').prop('src', '/schools/autocompletions?user_type=student');
      allowlistedForStudents = $('#js-default-email-domain-kind').val() === 'student' || $('#js-default-email-domain-kind').val() === 'mixed_use';
      $('#js-approved-email-icon').prop('hidden', !allowlistedForStudents);
      if (allowlistedForStudents) {
        schoolName = $('#js-default-email-school').val();
        $('#school-input').prop('value', schoolName);
      }
    }
    if ($userType.val() === 'faculty') {
      $('#application').prop('hidden', false);
      $('#partner_school_application_form').prop('hidden', true);
      $('.previous-requests').prop('hidden', false);
      $('#student-benefits-header').prop('hidden', true);
      $('#faculty-benefits-header').prop('hidden', false);
      $('#school-application-root').prop('hidden', true);
      $('#student-info').prop('hidden', true);
      $('#teacher-info').prop('hidden', false);
      $('#discount_request_user_type').val('faculty');
      $('#js-school-auto-complete').prop('src', '/schools/autocompletions?user_type=faculty');
      allowlistedForFaculty = $('#js-default-email-domain-kind').val() === 'faculty' || $('#js-default-email-domain-kind').val() === 'mixed_use';
      $('#js-approved-email-icon').prop('hidden', !allowlistedForFaculty);
      if (allowlistedForFaculty) {
        schoolName = $('#js-default-email-school').val();
        return $('#school-input').prop('value', schoolName);
      }
    }
    if ($userType.val() === 'school') {
      $('#application').prop('hidden', true);
      $('#partner_school_application_form').prop('hidden', false);

      $('#faculty-benefits-header').prop('hidden', true);
      $('#student-benefits-header').prop('hidden', true);
      $('#school-application-root').prop('hidden', false);

      $('#student-info').prop('hidden', true);
      $('#teacher-info').prop('hidden', true);

      $('.previous-requests').prop('hidden', true);
    }
  });

  $(document).on('click', '#school-type-selection input[name="school_type"]', function() {
    var $schoolTypeDescriptions, $selectedSchoolType;
    $schoolTypeDescriptions = {
      higherEducation: "Higher-education: university, college",
      school: "High school",
      educationalStructure: "Informal: bootcamp, career-training"
    };
    $selectedSchoolType = event.target.value;
    $('#discount_request_kind').val($schoolTypeDescriptions[$selectedSchoolType]);
    return GetMap();
  });

}).call(this);
// This class facilitates taking a photo using HTML5. The flow is:

// - Initialize video player with a user's camera stream (ask for permission)
// - The `Take Picture` button is clicked
// - Write one frame from the video to canvas
// - Convert the canvas to a 'image/png' base64 string
// - Convert the base64 string to a javascript `Blob` object (essentially a `file` object)
// - Populate hidden fields with base64 data and attachment metadata. see #createAttachmentData
// - At this point we're all ready to submit the normal form by the user.
//
class ImageCapture {
  constructor() {
    // The width and height of the captured photo. We will set the
    // width to the value defined here, but the height will be
    // calculated based on the aspect ratio of the input stream.

    this.width = 542; // We will scale the photo width to this
    this.height = 0; // This will be computed based on the input stream

    // |streaming| indicates whether or not we're currently streaming
    // video from the camera.
    this.streaming = false;

    this.started = false;

    this.deviceLabel = "";
  }

  init(suffix = "") {
    window.addEventListener("load", () => {
      this.cameraPrompt = document.querySelector(`.js-camera-prompt${suffix}`);
      // Return early if this.cameraPrompt doesn't exist
      // This prevents errors on other pages since we load all js at once
      if (!this.cameraPrompt) {
        return;
      }

      this.cameraPromptButton = this.cameraPrompt.querySelector(
        `.js-camera-prompt-button${suffix}`,
      );
      this.imageCapEl = document.querySelector(`.js-image-capture${suffix}`);
      this.initElements(suffix);

      this.cameraPromptButton.addEventListener("click", (evt) => {
        evt.preventDefault();

        if (!this.started) {
          this.startup();
          this.started = true;
        }
      });

      if (this.uploadButton) {
        this.uploadButton.addEventListener("change", (evt) => {
          this.setUploadImageData(evt);
        });
      }

      if (this.uploadBox) {
        // announce that the image has been uploaded for screen readers
        this.uploadBox.addEventListener('load', () => {
          LiveRegion.announce(
            "Thanks for uploading your photo. Please complete the form and submit when you're ready."
          );
        });
      }
    });
  }

  startup() {
    // Abort startup if the image-capture element doesn't exist
    if (!this.imageCapEl) {
      return;
    }

    this.toggleSpinner(true);
    this.showPromptError(false);

    // populate the devices dropdown and default to the first device
    this.detectAndShowDevices();

    this.startbutton.addEventListener(
      "click",
      (evt) => {
        evt.preventDefault();
        this.takePicture();
      },
      false,
    );

    this.resetButton.addEventListener("click", (evt) => {
      evt.preventDefault();
      this.resetImage();
    });

    this.clearPhoto();
  }

  initElements(suffix) {
    this.video = this.imageCapEl.querySelector(`.js-video${suffix}`);
    this.canvas = this.imageCapEl.querySelector(`.js-canvas${suffix}`);
    this.startbutton = this.imageCapEl.querySelector(
      `.js-start-button${suffix}`,
    );
    this.selectEl = this.imageCapEl.querySelector(`.js-device-select${suffix}`);

    this.cameraIcon = this.cameraPrompt.querySelector(
      `.js-camera-icon${suffix}`,
    );
    this.spinnerIcon = this.cameraPrompt.querySelector(
      `.js-spinner-icon${suffix}`,
    );
    this.cameraError = this.cameraPrompt.querySelector(
      `.js-camera-error${suffix}`,
    );
    this.cameraText = this.cameraPrompt.querySelector(
      `.js-camera-text${suffix}`,
    );

    this.imagePreview = this.imageCapEl.querySelector(
      `.js-image-preview${suffix}`,
    );
    this.uploadingText = this.imageCapEl.querySelector(
      `.js-uploading${suffix}`,
    );
    this.resetButton = this.imageCapEl.querySelector(
      `.js-reset-button${suffix}`,
    );
    this.videoWrapper = this.imageCapEl.querySelector(
      `.js-video-wrapper${suffix}`,
    );
    this.photoData = document.querySelector(`.js-photo-data${suffix}`);
    this.photoUrl = document.querySelector(`.js-photo-url${suffix}`);
    this.uploadButton = document.querySelector(".photo-upload-button");
    this.uploadBox = document.querySelector(".photo-upload-image");
    this.thanks = document.querySelector(`.js-thanks${suffix}`);
    if (!removeJSImageValidations()) {
      this.imageValidationErrors = document.querySelector(
        `.js-photo-validation-error-message${suffix}`
      );
      this.imageValidationMessageContainer = document.querySelector(
        `.js-photo-validation-error-message${suffix} .Banner-title`
      );
    }
  }

  // Show error on the camera prompt button
  // Passing false for the message resets the prompt button
  showPromptError(message) {
    if (message) {
      this.cameraError.hidden = false;
      this.cameraText.hidden = true;
      this.cameraError.querySelector("h3").textContent = message;
    } else {
      this.cameraError.hidden = true;
      this.cameraText.hidden = false;
    }
  }

  setUploadImageData(evt) {
    evt.preventDefault();

    let file = evt.target.files[0];

    if (file) {
      const reader = new FileReader();
      reader.onloadend = async () => {
        // outputs data:<type>;base64,wL2dvYWwgbW9yZ...
        let result = reader.result;
        this.uploadBox.src = result; // set src to display image preview
        this.photoUrl.value = result; // set image url in hidden field
        await this.setBinaryData({
          filename: file.name,
          base64Data: result,
          webcam: false,
        }); // set image data in hidden field

        if (!removeJSImageValidations()) {
          this.validateImage(file.size, this.uploadBox.naturalWidth, this.uploadBox.naturalHeight);
        }
      }
      reader.readAsDataURL(file);
      this.uploadBox.hidden = false;
    }
  }

  validateImage(size, width, height) {
    if (!removeJSImageValidations()) {
      // reset validation errors
      this.imageValidationMessageContainer.replaceChildren();
      this.imageValidationErrors.hidden = true;

      this.addImageValidationMessage(size > 1048576, "Photo is too large (maximum is 1 MB)");
      this.addImageValidationMessage(size < 1024, "Photo is too small (minimum is 1 KB)");
      this.addImageValidationMessage(width >= 10000 || height >= 10000, "Photo resolution is too large (maximum is 10000 by 10000)");
      this.addImageValidationMessage(width < 1024 || height < 768, "Photo resolution is too small (minimum is 1024 by 768)");

      if (this.imageValidationMessageContainer.children.length) {
        this.imageValidationErrors.hidden = false;
        LiveRegion.announce(this.imageValidationMessageContainer.textContent, "assertive")
      }
    }
  }

  addImageValidationMessage(condition, messageText) {
    if (!removeJSImageValidations()) {
      if (condition) {
        let message = document.createElement("p");
        message.textContent = messageText;
        this.imageValidationMessageContainer.appendChild(message);
      }
    }
  }

  async detectAndShowDevices() {
    const initialVideoDevices = await this.getVideoDevices();

    // If there are no video devices, then remove the entire video capture element.
    // Otherwise, initialize the video with the first device.
    if (initialVideoDevices.length === 0) {
      return;
    }

    // Re-fetch the video devices, since device labels don't exist until video
    // access has been approved by the user
    const videoDevices = await this.getVideoDevices();
    if (videoDevices.length === 0) {
      return;
    }
    this.populateDevices(videoDevices);
    this.deviceLabel = videoDevices[0].label;

    // Don't await this Promise. Instead, attach a callback to it to handle the stream when it's ready, but resolve
    // ours immediately.
    this.initializeVideo({ deviceId: { exact: videoDevices[0].deviceId } }).then((stream) => {
      // Return early if the stream doesn't exist. This usually happens when we don't have permission to use the camera.
      if (!stream) {
        return;
      }

      this.toggleSpinner(false);
      this.cameraPrompt.hidden = true;
      this.imageCapEl.hidden = false;
    })
  }

  toggleSpinner(spinnerVisible) {
    this.cameraIcon.hidden = spinnerVisible;
    this.spinnerIcon.hidden = !spinnerVisible;
  }

  stopStream(stream = null) {
    const dataStream = stream || this.stream;
    if (dataStream) {
      dataStream.getTracks().forEach((track) => {
        try {
          track.stop();
        } catch (err) {
          // Most likely an InvalidStateError. This track was not playing, so this is fine.
        }
      });
    }
  }

  async getVideoDevices() {
    try {
      await navigator.mediaDevices.getUserMedia({ video: true });
      const devices = await navigator.mediaDevices.enumerateDevices();
      const videoDevices = devices.filter((device) => device.kind === "videoinput");

      if (videoDevices.length === 0) {
        this.showPromptError("Error: No video devices detected");
        return [];
      }

      return videoDevices;
    } catch (err) {
      switch(err.name) {
        case "NotAllowedError":
          this.showPromptError("Error: You need to grant us access to your webcam");
          break;
        case "NotFoundError":
          this.showPromptError("Error: No video devices detected");
          break;
        default:
          this.showPromptError("Error: Could not access your webcam");
      }
      return [];
    };
  }

  // Populate the devices dropdown with available video devices
  populateDevices(devices) {
    let opt;

    this.selectEl.innerHTML = "";

    if (devices.length < 2) {
      this.selectEl.remove();
    }

    for (let device of devices) {
      opt = document.createElement("option");
      opt.textContent = this.getDeviceName(device.label);
      opt.value = device.deviceId;
      this.selectEl.appendChild(opt);
    }

    if (devices.length > 0) {
      this.initializeDeviceSelector(this.selectEl);
    }
  }

  // get a device name from the label. Most browsers give us the correct name, but Chrome in
  // particular adds some junk to the end of the label that we don't need.
  getDeviceName(label) {
    const match = label.match(/(.*)\(.*\)$/);

    if (match) {
      return match[1];
    } else {
      return label;
    }
  }

  // Bootstrap change event listener for the device selector
  initializeDeviceSelector(selectEl) {
    selectEl.addEventListener("change", async (evt) => {
      // Don't wait for this Promise to resolve. We don't need to wait for the video to fully load to set the label.
      this.initializeVideo({ deviceId: { exact: evt.target.value } });

      const videoDevices = await this.getVideoDevices();
      const chosenDevice = videoDevices.find((device) => device.deviceId == evt.target.value);
      if (chosenDevice) {
        this.deviceLabel = chosenDevice.label;
      }
    });
  }

  // Start the video stream, `options` are passed to the video item
  async initializeVideo(options = {}) {
    try {
      const opts = { video: options };
      const stream = await navigator.mediaDevices.getUserMedia(opts);

      this.video.srcObject = stream;

      const playPromise = this.video.play();
      // "Browsers released before 2019 may not return a value from play()." - MDN
      if (playPromise) {
        playPromise.catch((_err) => {
          this.showPromptError("Error: Unable to start your webcam");
        });
      }

      this.stopStream(this.stream);
      this.stream = stream;

      // resolve only after the video is completely loaded
      const loadedPromise = new Promise((resolve) => {
        this.video.addEventListener("loadeddata", () => {
          resolve(stream);
        });
      });

      this.video.addEventListener("canplay", () => this.handleCanPlay(), { once: true });

      return loadedPromise;
    } catch (err) {
      this.showPromptError("Error: Unable to start your webcam");
      return null;
    }
  }

  handleCanPlay(evt) {
    if (!this.streaming) {
      this.height =
        this.video.videoHeight / (this.video.videoWidth / this.width);

      // Firefox currently has a bug where the height can't be read from
      // the video, so we will make assumptions if this happens.
      if (isNaN(this.height)) {
        this.height = this.width / (4 / 3);
      }

      this.canvas.setAttribute("width", this.width);
      this.canvas.setAttribute("height", this.height);
      this.streaming = true;
    }
  }

  resetImage() {
    this.resetButton.hidden = true;
    this.startbutton.disabled = false;
    this.startbutton.hidden = false;
    this.startbutton.focus();
    this.imagePreview.hidden = true;
    this.selectEl.hidden = false;
    this.thanks.hidden = true;
    this.clearPhoto();
    this.detectAndShowDevices();
  }

  // Fill the photo with an indication that none has been
  // captured.
  clearPhoto() {
    const context = this.canvas.getContext("2d");
    context.fillStyle = "#AAA";
    context.fillRect(0, 0, this.canvas.width, this.canvas.height);
  }

  // Capture a photo by fetching the current contents of the video
  // and drawing it into a canvas, then converting that to a PNG
  // format data URL. By drawing it on an offscreen canvas and then
  // drawing that to the screen, we can change its size and/or apply
  // other changes before drawing it.
  async takePicture() {
    const context = this.canvas.getContext("2d");
    if (this.width && this.height) {
      this.startbutton.disabled = true;
      this.uploadingText.hidden = false;
      this.canvas.width = this.width;
      this.canvas.height = this.height;
      context.drawImage(this.video, 0, 0, this.width, this.height);

      const data = this.canvas.toDataURL("image/png");

      this.imagePreview.src = data;
      this.imagePreview.hidden = false;
      await this.setImageData(data); // sends to Azure
      this.stopStream();
      this.resetButton.hidden = false;

      // for screen readers, announce that we're done taking a picture
      LiveRegion.announce("Thanks for uploading your photo.  Please complete the form and submit when you're ready.");
    } else {
      this.clearPhoto();
    }
  }

  async setImageData(data) {
    await this.setBinaryData({
      filename: "image_upload",
      base64Data: data,
      webcam: true,
    }); // sets image data in hidden field
    this.photoUrl.value = data; // sets image url in hidden field
    this.uploadingText.hidden = true;
    this.thanks.hidden = false;
    this.startbutton.disabled = false;
  }

  async getImageType(blob, webcam) {
    // return early if the image isn't a jpeg or if webcam was used
    // (pngs don't have EXIF data)
    if (webcam === true) {
      return "camera";
    } else if (blob.type != "image/jpeg") {
      return "upload";
    }

    // DateTimeOriginal format : Sun Oct 31 2021 20:39:42 GMT+0530 (India Standard Time)
    const exif = await exifr.parse(blob, ["DateTimeOriginal"]);
    const date = exif?.DateTimeOriginal;

    if (!date) {
      return "upload";
    }

    // if the image was taken within the last 5 minutes,
    // assume it was taken with the camera
    let prevDate = new Date(date);
    let toDate = new Date();
    let within5Minutes = toDate - prevDate < 300000; // 5 minutes in ms

    if (within5Minutes) {
      return "camera";
    } else {
      return "upload";
    }
  }

  // Set metadata and base64 image in hidden photo field
  async setBinaryData({ filename, base64Data, webcam }) {
    const blob = this.convertBase64ToBlob(base64Data);

    const type = await this.getImageType(blob, webcam);
    const attachmentData = this.createAttachmentData({
      size: blob.size,
      mimetype: blob.type,
      deviceLabel: this.deviceLabel,
      type: type,
      filename: filename,
    });
    this.photoData.value = attachmentData; // sets binary data in hidden field
  }

  // Convert base64 data to a file blob object
  // This is used when uploading the image to Azure
  convertBase64ToBlob(data) {
    const splitData = data.split(",");
    const byteString = atob(splitData[1]);
    const mimeString = splitData[0].match(/:(.*);/)[1];
    const byteArray = new Uint8Array(byteString.length);

    for (let i = 0; i < byteString.length; i++) {
      byteArray[i] = byteString.charCodeAt(i);
    }

    return new Blob([byteArray], { type: mimeString });
  }

  // Format attachment data that the server expects
  createAttachmentData(options) {
    const image = {
      id: "azure_upload", // shrine validators require this field
      storage: "cache",
      metadata: {
        size: options.size,
        filename: options.filename,
        mime_type: options.mimetype,
        type: options.type,
        device_label: options.deviceLabel,
      },
    };
    return JSON.stringify(image);
  }
}

(function () {
  let imageCapture = new ImageCapture();
  imageCapture.init();

  let imageCaptureForFarCampus = new ImageCapture();
  imageCaptureForFarCampus.init("-far-campus");
})();
class LiveRegion {
  /**
   * Announces a message in the live region container, which is read by screen readers.
   *
   * Note: Use caution when using this function while a dialog is active.
   * If the message is updated while the dialog is open, the screen reader may not announce the live region.
   * For more information, view the document on dialog and live region support:
   * https://github.com/github/accessibility/blob/main/docs/dialog-live-region-support.md
   *
   * @param {string} message - The message to be announced.
   * @param {string} role - The role of the live region container. Default is "polite".
   */
  static announce(message, role = "polite") {
    const container = LiveRegion.#getContainer(role)

    if (container.textContent === message) {
      container.textContent = `${message}\xA0`
    } else {
      container.textContent = message
    }
  }

  static #getContainer(role) {
    const container = document.getElementById(`js-global-edu-live-region-${role}`)
    if (!container) {
      throw new Error("Unable to find container for message")
    }

    return container
  }
}
;
$(document).ready(() => formShown());

var formShown = function () {
  handleCountryChange();
  handleEmailDomainChange();
  handleTaxInformationChange();
  handleAddAdministrators();
  handleAddDomain();
  handleRemoveDummyAdminDomain();
};

var handleCountryChange = function () {
  const $countrySelect = $(".js-country-select");
  const $legalIdField = $(".js-legal-id");
  const $legalIdCountries = [
    "AM",
    "AZ",
    "BY",
    "BR",
    "CN",
    "HU",
    "IN",
    "IQ",
    "KZ",
    "MD",
    "MM",
    "PL",
    "RU",
    "SA",
    "ZA",
    "SD",
    "TJ",
    "TH",
    "TR",
    "UA",
    "AE",
    "UZ",
    "VE",
    "VN",
  ];

  $countrySelect.change(function () {
    const $countryValue = $(this).val();

    if ($legalIdCountries.includes($countryValue)) {
      $legalIdField.show();
      $("#legalIdField").prop("required", true);
      $("#registrationField").prop("required", true);
    } else {
      $legalIdField.hide();
      $("#legalIdField").prop("required", false);
      $("#registrationField").prop("required", false);
    }
  });
};

const handleRemoveAdmin = () =>
  $(document).on('click', '.remove-fields', function (event) {
    event.preventDefault();
    $(this).closest(".admin-info").remove();
  });

const handleRemoveDomain = () =>
  $(".remove-fields").click(function (event) {
    event.preventDefault();
    $(this).closest(".domain-info").remove();
  });

var handleEmailDomainChange = function () {
  const $emailDomain = $("#partner_school_application_email_address");

  $emailDomain.change(function () {
    const domain = $emailDomain.val() || "";
    const $emailDomainMessage = $(".js-email-domain-message");
    const $submitButton = $(".js-submit-button");
    const disallowedDomains = [
      "gmail.com",
      "yahoo.com",
      "qq.com",
      "hotmail.com",
    ];

    if (
      disallowedDomains.some((disallowedDomain) =>
        domain.endsWith(disallowedDomain),
      )
    ) {
      $emailDomainMessage.show();
      $submitButton.prop("disabled", true);
    } else {
      $emailDomainMessage.hide();
      $submitButton.prop("disabled", false);
    }
  });
};

var handleTaxInformationChange = function () {
  $("#legalIdField").change(function () {
    if ($(this).val().length > 0) {
      $("#legalIdField").prop("required", true);
      $("#registrationField").prop("required", false);
    } else {
      $("#registrationField").prop("required", true);
    }
  });

  return $("#registrationField").change(function () {
    if ($(this) != null && $(this).val().length > 0) {
      $("#legalIdField").prop("required", false);
      $("#registrationField").prop("required", true);
    } else {
      $("#legalIdField").prop("required", true);
    }
  });
};

var handleAddAdministrators = function () {
  const $newAdmin = $(".admin-info");
  let $indexAdmins = $(".add-admin__form__js-show").length - 1;

  $("#add-admin-button-js").on("click", function (event) {
    $indexAdmins++;
    const $newAdminClone = $newAdmin.clone();

    $newAdminClone.find("input:text").each((_, node) => {
      $(node).attr("id", node.id.replace("admin_index", $indexAdmins));
      $(node).attr("name", node.name.replace("admin_index", $indexAdmins));
    });

    $(".add-admin__form__js-show").append($newAdminClone.show());
    $(".add-admin__form__js-show").last().append($("#add-admin-button-js"));
    handleRemoveAdmin();
  });
};

var handleAddDomain = function () {
  const $newDomain = $(".domain-info");
  let $indexDomains = $("#domains-list").length - 1;

  $(".add-domain").on("click", function (event) {
    $indexDomains++;
    const $newDomainClone = $newDomain.clone();

    $newDomainClone
      .find("input:text, input:checkbox, input:hidden, select, label")
      .each((_, node) => {
        if ($(node).is("label")) {
          const currNode = $(node);
          currNode.attr(
            "for",
            currNode.attr("for").replace("domain_index", $indexDomains),
          );
        } else {
          $(node).attr("id", node.id.replace("domain_index", $indexDomains));
          $(node).attr(
            "name",
            node.name.replace("domain_index", $indexDomains),
          );
        }
      });

    $("#domains-list").append($newDomainClone.show());
    handleRemoveDomain();
  });
};

const checkUncheckedDomainEligibleUser = function () {
  const $domains_list = $(".domain-info:visible");
  let $unchecked_users = false;

  $domains_list.each((_, node) => {
    if (!$(node).find("input:checkbox:checked").length) {
      $unchecked_users = true;
      return false;
    }
  });

  if ($unchecked_users) {
    return false;
  }

  if (!$("#default-domain").find("input:checkbox:checked").length) {
    return false;
  }

  return true;
};

var handleRemoveDummyAdminDomain = () =>
  $("#send-psa-application").on("click", function (event) {
    const $admin_list = $(".add-admin__form__js-show");
    const $domains_list = $("#domains-list");

    $admin_list.find("input:text").each((_, node) => {
      if (!$(node).val() && $(node).is(":visible")) {
        return;
      }
    });

    $domains_list.find("input:text, select").each((_, node) => {
      if (!$(node).val() && $(node).is(":visible")) {
        return;
      }
    });

    if (!checkUncheckedDomainEligibleUser()) {
      $("#user-unchecked-warning").show().attr("tabindex", -1).focus();
      return;
    }

    $(".add-admin__form__js-show").children().first().remove();
    $("#domains-list").children().first().remove();
  });
$(document).ready(() => startRotator());

var startRotator = function () {
  prepareRotator();
  return setInterval(() => rotateLogos(), 5000);
};

var prepareRotator = function () {
  $("#rotator img").hide();
  const logos = $(getRandomLogos($("#rotator img")));
  logos.addClass("active").fadeIn(200);
  return logos.parent().addClass("col-2 p-8");
};

var getRandomLogos = function (logos) {
  const shuffledLogos = logos.sort(() => 0.5 - Math.random());
  // Pick 6 logos
  return shuffledLogos.slice(0, 6);
};

var rotateLogos = function () {
  const activeLogos = $("#rotator img.active");
  const nextLogos = $(getRandomLogos($("#rotator img")));
  activeLogos.removeClass("active").hide();
  activeLogos.parent().removeClass("col-2 p-8");
  nextLogos.addClass("active").fadeIn(200);
  return nextLogos.parent().addClass("col-2 p-8");
};
$(function () {
  if ($("[data-story]").length) {
    $(".js-switch-story").click((tab) => {
      tab.addClass("active");
      tab.siblings().removeClass("active");

      const name = tab.attr("href").slice(1);
      const target = `[data-story='${name}']`;

      const players = $(".js-story").not(target).children().find("iframe");
      for (let player of players) {
        player.contentWindow.postMessage('{"method":"pause"}', "*");
      }

      $(".js-story").not(target).hide();
      $(target).show();
    });

    if (location.hash) {
      // Viewing a particular story
      $(`[href=${location.hash}]`).click();
    } else {
      $(".js-switch-story").first().click();
    }
  }
});
$(document).ready(() => {
    let button = document.getElementById('back-to-top');
    if (button) {
        let showing = false;
        window.addEventListener('scroll', function(e) {
            if (window.scrollY > 600) {
                if (!showing)
                    button.classList.remove('hidden');
                showing = true;
            } else {
                if (showing)
                    button.classList.add('hidden');
                showing = false;
            }
        });
    }
});

